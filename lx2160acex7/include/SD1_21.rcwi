/*
 * Serdes 1 Reference Clocks:
 * - PLLF = 161.1328125MHz
 * - PLLS = 100MHz
 */

/* Serdes 1 Protocol 21: 4x25Gbps + 1xPCI-e-x2 + 2x25Gbps */
SRDS_PRTCL_S1=21

/* Enable Serdes 1 PLLF (25G lanes) */
SRDS_PLL_PD_PLL1=0

/* Don't use Serdes 1 PLLF for PLLS: PLLS needs its own 100MHz clock for PCI-e */
SRDS_INTRA_REF_CLK_S1=0

/* Enable Serdes 1 PLLS (PCI-e lanes) */
SRDS_PLL_PD_PLL2=0

/*
 * Select Serdes 1 PLLF frequency 161.1328125MHz for 25.78125G: Bit 0 = 0
 * Select Serdes 1 PLLS frequency 100MHz for pcie: Bit 1 = 0
 * (See QorIQ LX2160A Reference Manual, Rev. 0, 07/2020, 4.9.8.9 Reset Control Word (RCW) Register Descriptions, Bits 932-933)
 */
SRDS_PLL_REF_CLK_SEL_S1=0

/* Support up to PCI-e Gen 3 */
SRDS_DIV_PEX_S1=1

/* indicate PCI ports for pbi section errata application*/
#define HAVE_PEX2
